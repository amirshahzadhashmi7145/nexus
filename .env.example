# Copy to .env and adjust. Never commit real secrets.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# Business DB: preferred = Postgres via Docker Compose.
# Option A (explicit URL — recommended for demos):
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Option B (no DATABASE_URL): set NEXUS_DB=postgres|sqlite
# NEXUS_DB=postgres
# Leave both unset → SQLite file at data/novacart.db

REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# LLM generation (answers / structured JSON)
# Path: stub (default) → openai_compatible (paid API) → FINAL: vLLM on AMD
# Check: GET /api/v1/llm/status
# ---------------------------------------------------------------------------
LLM_PROVIDER=stub
# Live OpenAI (or any OpenAI-compatible host):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# FINAL TARGET — vLLM OpenAI-compatible server on AMD/ROCm:
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# (model name must match whatever vLLM loaded)

# ---------------------------------------------------------------------------
# RAG embeddings (retrieval only — different from vLLM chat)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=tfidf
# EMBEDDING_PROVIDER=minilm
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# uv pip install -r apps/api/requirements-embeddings.txt
