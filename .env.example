# Copy to .env and adjust. Never commit real secrets.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0

# LLM (Phase 6). Default stub needs no key.
LLM_PROVIDER=stub
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# Later local AMD/vLLM example:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=your-model

# RAG embeddings (Phase 11). Default tfidf needs no download.
EMBEDDING_PROVIDER=tfidf
# EMBEDDING_PROVIDER=minilm
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Install optional deps first: uv pip install -r apps/api/requirements-embeddings.txt
