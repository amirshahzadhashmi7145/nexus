{
  "mcpServers": {
    "nexus-novacart": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "apps/api",
        "python",
        "-m",
        "app.mcp_server"
      ],
      "env": {
        "PYTHONPATH": ".",
        "DATABASE_URL": "sqlite+pysqlite:///../../data/novacart.db",
        "LLM_PROVIDER": "stub"
      }
    }
  }
}
