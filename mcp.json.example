{
  "mcpServers": {
    "nexus-novacart": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.mcp_server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/api",
        "DATABASE_URL": "sqlite+pysqlite:///${workspaceFolder}/data/novacart.db",
        "LLM_PROVIDER": "stub"
      }
    }
  }
}
